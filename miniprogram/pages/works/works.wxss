page {
  background: #f3f6fb;
}

.works-page {
  padding-bottom: calc(154rpx + env(safe-area-inset-bottom));
}

.portfolio-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  margin-bottom: 22rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.9);
  border-radius: 22rpx;
  background: linear-gradient(145deg, #fff 0%, #f5f8ff 100%);
  box-shadow: 0 8rpx 26rpx rgba(29, 49, 82, 0.055);
}

.summary-copy {
  min-width: 0;
}

.summary-title {
  color: var(--text-900);
  font-size: 30rpx;
  font-weight: 700;
}

.summary-desc {
  max-width: 500rpx;
  margin-top: 8rpx;
  color: var(--text-500);
  font-size: 21rpx;
  line-height: 1.5;
}

.summary-count {
  flex: none;
  margin-left: 18rpx;
  color: var(--brand-600);
  font-size: 45rpx;
  line-height: 1;
  font-weight: 750;
}

.summary-count text {
  margin-left: 5rpx;
  color: var(--text-400);
  font-size: 19rpx;
  font-weight: 500;
}

.page-state {
  min-height: 500rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 34rpx;
  box-sizing: border-box;
  text-align: center;
}

.state-spinner,
.upload-spinner {
  border: 5rpx solid #dbe5f8;
  border-top-color: var(--brand-600);
  border-radius: 50%;
  animation: state-spin 0.8s linear infinite;
}

.state-spinner {
  width: 48rpx;
  height: 48rpx;
}

.state-icon,
.empty-visual {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 23rpx;
  background: #eaf0ff;
  color: var(--brand-600);
  font-size: 35rpx;
  font-weight: 700;
}

.state-title {
  margin-top: 22rpx;
  color: var(--text-700);
  font-size: 28rpx;
  font-weight: 650;
}

.state-desc {
  max-width: 500rpx;
  margin-top: 9rpx;
  color: var(--text-400);
  font-size: 22rpx;
  line-height: 1.55;
}

.retry-btn {
  min-width: 220rpx;
  margin-top: 26rpx;
}

.empty-state {
  min-height: 460rpx;
}

.work-card {
  padding: 0;
  overflow: hidden;
}

.cover,
.cover-placeholder-card {
  width: 100%;
  height: 310rpx;
}

.cover {
  display: block;
}

.cover-placeholder-card {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background:
    linear-gradient(135deg, rgba(39, 92, 213, 0.08), rgba(105, 175, 255, 0.05)),
    repeating-linear-gradient(45deg, transparent 0, transparent 30rpx, rgba(36, 87, 214, 0.035) 30rpx, rgba(36, 87, 214, 0.035) 31rpx);
}

.cover-letter {
  color: rgba(36, 87, 214, 0.36);
  font-size: 82rpx;
  line-height: 1;
  font-weight: 800;
}

.cover-caption {
  margin-top: 15rpx;
  color: rgba(36, 87, 214, 0.42);
  font-size: 18rpx;
  letter-spacing: 5rpx;
}

.work-body {
  padding: 25rpx 29rpx 28rpx;
}

.work-meta {
  margin-bottom: 8rpx;
  color: var(--text-400);
  font-size: 19rpx;
}

.work-body .card-title {
  margin-bottom: 8rpx;
  font-size: 29rpx;
}

.work-desc {
  line-height: 1.65;
}

.hash-line {
  display: flex;
  align-items: center;
  min-width: 0;
  padding-top: 18rpx;
  margin-top: 19rpx;
  border-top: 1rpx solid #edf1f5;
  transition: opacity 120ms ease, background-color 120ms ease;
}

.hash-line--pressed {
  opacity: 0.7;
}

.hash-badge {
  flex: none;
  display: flex;
  align-items: center;
  padding: 7rpx 12rpx;
  border: 1rpx solid #cee6da;
  border-radius: 999rpx;
  background: #f0faf5;
  color: var(--success-600);
  font-size: 19rpx;
  font-weight: 650;
}

.mini-lock {
  position: relative;
  width: 21rpx;
  height: 23rpx;
  margin-right: 7rpx;
}

.mini-lock-shackle {
  position: absolute;
  top: 0;
  left: 5rpx;
  width: 12rpx;
  height: 12rpx;
  border: 3rpx solid var(--success-600);
  border-bottom: 0;
  border-radius: 7rpx 7rpx 0 0;
  box-sizing: border-box;
}

.mini-lock-body {
  position: absolute;
  left: 2rpx;
  bottom: 0;
  width: 18rpx;
  height: 14rpx;
  border-radius: 4rpx;
  background: var(--success-600);
}

.hash-value {
  min-width: 0;
  flex: 1;
  margin-left: 11rpx;
  overflow: hidden;
  color: #8994a5;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hash-arrow {
  flex: none;
  margin-left: 8rpx;
  color: #8b96a7;
  font-size: 24rpx;
}

.hash-detail {
  padding: 18rpx;
  margin-top: 14rpx;
  border: 1rpx solid #dce9e2;
  border-radius: 14rpx;
  background: #f6fbf8;
  transition: opacity 120ms ease;
}

.hash-detail--pressed {
  opacity: 0.7;
}

.hash-detail-label {
  color: #527364;
  font-size: 19rpx;
  font-weight: 650;
}

.hash-detail-value {
  margin-top: 9rpx;
  overflow-wrap: anywhere;
  color: #5d6b64;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 18rpx;
  line-height: 1.55;
}

.hash-detail-copy {
  margin-top: 8rpx;
  color: var(--success-600);
  font-size: 18rpx;
}

.fab {
  position: fixed;
  z-index: 30;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  width: auto;
  box-shadow: 0 12rpx 28rpx rgba(36, 87, 214, 0.2);
}

.fab-plus {
  margin-right: 10rpx;
  font-size: 32rpx;
  font-weight: 400;
}

.mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.48);
}

.sheet {
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  padding: 19rpx 32rpx calc(35rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #fff;
  box-sizing: border-box;
  box-shadow: 0 -14rpx 44rpx rgba(15, 23, 42, 0.12);
}

.sheet-handle {
  width: 72rpx;
  height: 7rpx;
  margin: 0 auto 21rpx;
  border-radius: 999rpx;
  background: #d9dee7;
}

.sheet-title {
  color: var(--text-900);
  font-size: 31rpx;
  font-weight: 700;
  text-align: center;
}

.sheet-subtitle {
  max-width: 560rpx;
  margin: 9rpx auto 25rpx;
  color: var(--text-400);
  font-size: 20rpx;
  line-height: 1.5;
  text-align: center;
}

.cover-picker {
  position: relative;
  width: 100%;
  height: 270rpx;
  overflow: hidden;
  margin-bottom: 23rpx;
  border-radius: 18rpx;
  background: var(--surface-soft);
  transition: transform 120ms ease, opacity 120ms ease;
}

.cover-preview {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #cbd5e1;
  border-radius: 18rpx;
  box-sizing: border-box;
  color: var(--text-500);
  font-size: 22rpx;
}

.picker-plus {
  margin-bottom: 8rpx;
  color: var(--brand-600);
  font-size: 42rpx;
  line-height: 1;
}

.upload-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(15, 23, 42, 0.58);
  color: #fff;
  font-size: 21rpx;
}

.upload-spinner {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 13rpx;
  border-color: rgba(255, 255, 255, 0.35);
  border-top-color: #fff;
}

.upload-done {
  position: absolute;
  right: 14rpx;
  bottom: 14rpx;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  background: rgba(22, 139, 91, 0.92);
  color: #fff;
  font-size: 18rpx;
}

.field-label {
  margin: 18rpx 0 10rpx;
  color: var(--text-700);
  font-size: 22rpx;
  font-weight: 650;
}

.field-label text {
  color: var(--danger-600);
}

.f-input,
.f-textarea {
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 15rpx;
  background: var(--surface-soft);
  box-sizing: border-box;
  color: var(--text-900);
  font-size: 25rpx;
}

.f-input {
  height: 78rpx;
}

.f-textarea {
  min-height: 150rpx;
}

.char-count {
  margin: 8rpx 4rpx 24rpx;
  color: var(--text-400);
  font-size: 18rpx;
  text-align: right;
}

.cancel {
  margin-top: 8rpx;
}

@keyframes state-spin {
  to { transform: rotate(360deg); }
}
