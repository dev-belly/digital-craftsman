page {
  background: #f4f7fb;
}

.enterprise-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(46rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.top-panel {
  padding: 34rpx 30rpx 36rpx;
  border-radius: 24rpx;
  background: linear-gradient(140deg, #193f8d, #2d67d1);
  color: #fff;
  box-shadow: 0 12rpx 32rpx rgba(31, 72, 153, 0.18);
}

.company-row {
  display: flex;
  align-items: center;
}

.company-logo {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  margin-right: 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.18);
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
}

.company-main {
  flex: 1;
  min-width: 0;
}

.hello {
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.company-name {
  margin-top: 6rpx;
  overflow: hidden;
  font-size: 38rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.company-actions {
  flex: none;
  display: flex;
  gap: 8rpx;
  margin-left: 12rpx;
}

.header-action {
  flex: none;
  padding: 11rpx 15rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 20rpx;
  transition: transform 120ms ease, background-color 120ms ease;
}

.header-action--pressed {
  background: rgba(255, 255, 255, 0.25);
  transform: scale(0.96);
}

.company-sub {
  margin-top: 28rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 22rpx;
}

.action-card {
  min-height: 150rpx;
  padding: 22rpx 22rpx 18rpx;
  border: 1rpx solid #e8edf6;
  border-radius: 18rpx;
  background: #fff;
  box-sizing: border-box;
  box-shadow: 0 7rpx 22rpx rgba(29, 49, 82, 0.05);
  transition: transform 120ms ease, opacity 120ms ease, box-shadow 120ms ease;
}

.action-card--scan {
  border-color: rgba(36, 87, 214, 0.28);
}

.action-card--pressed {
  opacity: 0.88;
  transform: scale(0.975);
  box-shadow: 0 3rpx 12rpx rgba(29, 49, 82, 0.05);
}

.action-card--static {
  background: #f8fafc;
  box-shadow: none;
}

.action-icon {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 14rpx;
  background: var(--brand-50);
  color: var(--brand-600);
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
}

.action-title {
  margin-top: 16rpx;
  color: #17233d;
  font-size: 24rpx;
  font-weight: 700;
}

.action-desc {
  margin-top: 6rpx;
  color: #8a96a8;
  font-size: 22rpx;
  line-height: 1.35;
}

.search-card {
  padding: 24rpx;
  margin-top: 22rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.82);
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 8rpx 26rpx rgba(29, 49, 82, 0.05);
}

.jobs-card {
  padding: 24rpx;
  margin-top: 22rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.82);
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 8rpx 26rpx rgba(29, 49, 82, 0.05);
}

.activity-card {
  padding: 24rpx;
  margin-top: 22rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.82);
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 8rpx 26rpx rgba(29, 49, 82, 0.05);
}

.activity-section {
  margin-top: 22rpx;
}

.activity-section-title {
  padding-bottom: 10rpx;
  color: #52647e;
  font-size: 20rpx;
  font-weight: 650;
}

.activity-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #edf1f6;
}

.activity-row--compact {
  flex-wrap: nowrap;
}

.activity-main {
  flex: 1;
  min-width: 260rpx;
}

.activity-name {
  overflow: hidden;
  color: #25334b;
  font-size: 22rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-meta {
  margin-top: 5rpx;
  color: #8a96a8;
  font-size: 18rpx;
}

.activity-status {
  flex: none;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #fff4df;
  color: #a86500;
  font-size: 18rpx;
}

.activity-status--accepted {
  background: #e9f8f0;
  color: #168759;
}

.activity-status--declined {
  background: #f3f4f6;
  color: #7c8798;
}

.activity-actions {
  display: flex;
  gap: 10rpx;
  width: 100%;
}

.activity-btn {
  flex: 1;
}

.jobs-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.jobs-title {
  color: #17233d;
  font-size: 28rpx;
  font-weight: 700;
}

.jobs-desc {
  margin-top: 5rpx;
  color: #98a2b3;
  font-size: 20rpx;
}

.jobs-count {
  flex: none;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: var(--brand-600);
  font-size: 19rpx;
  font-weight: 600;
}

.job-list {
  margin-top: 18rpx;
}

.job-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 17rpx 0;
  border-top: 1rpx solid #edf1f6;
}

.job-main {
  flex: 1;
  min-width: 0;
}

.job-name {
  overflow: hidden;
  color: #25334b;
  font-size: 24rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.job-meta {
  margin-top: 5rpx;
  overflow: hidden;
  color: #8a96a8;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.job-status {
  flex: none;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  background: #e9f8f0;
  color: #168759;
  font-size: 18rpx;
}

.job-status.closed {
  background: #f1f3f6;
  color: #7d8796;
}

.jobs-empty {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  background: #f7f9fc;
  color: #8995a7;
  font-size: 21rpx;
  line-height: 1.45;
}

.search-title {
  margin-bottom: 18rpx;
  color: #17233d;
  font-size: 30rpx;
  font-weight: 700;
}

.search-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.search-row--filters {
  margin-top: 12rpx;
}

.search-input,
.index-input {
  min-width: 0;
  height: 76rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  background: var(--surface-soft);
  color: #1d2a40;
  font-size: 24rpx;
  box-sizing: border-box;
}

.search-input {
  flex: 1;
}

.index-input {
  flex: 1;
}

.input-placeholder {
  color: #a7b0be;
}

.search-btn {
  flex: none;
  width: 180rpx;
}

.search-help {
  margin-top: 14rpx;
  color: #98a2b3;
  font-size: 20rpx;
  line-height: 1.45;
}

.loading-state,
.empty-state {
  padding: 88rpx 20rpx;
  color: #8a96a8;
  text-align: center;
  font-size: 24rpx;
}

.error-state {
  min-height: 440rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 30rpx;
  box-sizing: border-box;
  text-align: center;
}

.error-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  border-radius: 23rpx;
  background: #eaf0ff;
  color: var(--brand-600);
  font-size: 34rpx;
  font-weight: 700;
}

.error-title {
  margin-top: 22rpx;
  color: #344054;
  font-size: 28rpx;
  font-weight: 650;
}

.error-desc {
  margin-top: 9rpx;
  color: #98a2b3;
  font-size: 22rpx;
}

.error-retry {
  min-width: 220rpx;
  margin-top: 26rpx;
}

.talent-list {
  margin-top: 18rpx;
}

.talent-card {
  padding: 26rpx;
  margin-bottom: 18rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.82);
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 8rpx 26rpx rgba(29, 49, 82, 0.05);
}

.talent-top {
  display: flex;
  align-items: center;
}

.talent-avatar {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: #eef4ff;
  color: var(--brand-600);
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
}

.talent-info {
  flex: 1;
  min-width: 0;
}

.talent-name {
  color: #17233d;
  font-size: 30rpx;
  font-weight: 700;
}

.talent-meta,
.stage-summary {
  margin-top: 5rpx;
  color: #8a96a8;
  font-size: 21rpx;
}

.stage-summary {
  color: #49627f;
}

.talent-index {
  flex: none;
  min-width: 82rpx;
  text-align: right;
}

.talent-score {
  color: #f2a100;
  font-size: 40rpx;
  font-weight: 700;
}

.talent-score-label {
  color: #9aa4b5;
  font-size: 18rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}

.skill-tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #eef5ff;
  color: #2f62be;
  font-size: 20rpx;
}

.stage-dots {
  display: flex;
  gap: 10rpx;
  margin-top: 18rpx;
}

.stage-dot {
  flex: 1;
  height: 8rpx;
  border-radius: 999rpx;
  background: #dfe5ef;
}

.stage-dot.done {
  background: #20b26b;
}

.stage-dot.doing {
  background: #f2a100;
}

.talent-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 22rpx;
}

.talent-actions .primary-btn {
  grid-column: 1 / -1;
}

.plain-btn {
  padding: 0 12rpx;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.42);
}

.sheet {
  width: 100%;
  height: 82vh;
  max-height: 920rpx;
  padding: 34rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
  box-sizing: border-box;
  box-shadow: 0 -14rpx 44rpx rgba(15, 23, 42, 0.12);
}

.sheet-title {
  color: #17233d;
  text-align: center;
  font-size: 31rpx;
  font-weight: 700;
}

.field-label {
  margin: 26rpx 0 12rpx;
  color: #34425a;
  font-size: 23rpx;
  font-weight: 600;
}

.sheet-notice {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #eef4ff;
  color: #46628e;
  font-size: 21rpx;
  line-height: 1.5;
}

.sheet-input,
.picker-value {
  height: 82rpx;
  line-height: 82rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  background: var(--surface-soft);
  color: #1d2a40;
  font-size: 25rpx;
  box-sizing: border-box;
}

.sheet-textarea {
  width: 100%;
  min-height: 150rpx;
  padding: 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  background: var(--surface-soft);
  color: #1d2a40;
  font-size: 25rpx;
  box-sizing: border-box;
}

.field-counter {
  margin: 8rpx 4rpx 0;
  color: #98a2b3;
  font-size: 18rpx;
  text-align: right;
}

.score-row {
  display: flex;
  justify-content: space-between;
  margin-top: 26rpx;
  color: #34425a;
  font-size: 24rpx;
}

.score-value {
  color: #f2a100;
  font-size: 32rpx;
  font-weight: 700;
}

.sheet-submit {
  margin-top: 26rpx;
}

.sheet-cancel {
  margin-top: 8rpx;
}

@media (max-width: 340px) {
  .enterprise-page {
    padding-left: 18rpx;
    padding-right: 18rpx;
  }

  .top-panel {
    padding-left: 24rpx;
    padding-right: 24rpx;
  }

  .company-name {
    font-size: 33rpx;
  }

  .action-grid {
    gap: 12rpx;
  }

  .action-card {
    padding-left: 16rpx;
    padding-right: 16rpx;
  }
}
