.privacy-wrap {
  padding: 32rpx 28rpx calc(60rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  min-height: 100vh;
  box-sizing: border-box;
}
.privacy-content {
  background: #fff;
  border: 1rpx solid rgba(226, 232, 240, 0.82);
  border-radius: 24rpx;
  padding: 36rpx;
  box-shadow: var(--shadow-card);
}
.section-title {
  color: var(--text-900);
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.updated {
  color: var(--text-400);
  font-size: 24rpx;
  margin-bottom: 32rpx;
}
.sub-title {
  color: var(--text-900);
  font-size: 30rpx;
  font-weight: 600;
  margin: 28rpx 0 12rpx;
}
.text {
  font-size: 26rpx;
  color: var(--text-700);
  line-height: 1.7;
  margin-bottom: 6rpx;
}
.back-btn {
  margin-top: 40rpx;
}
