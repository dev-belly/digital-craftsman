page {
  background: #f2f5fa;
}

.archive-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 64rpx;
  box-sizing: border-box;
  overflow: hidden;
}

/* 加载与空状态 */
.loading-state,
.not-found {
  min-height: 78vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #7c8799;
}

.loading-ring {
  width: 54rpx;
  height: 54rpx;
  border: 5rpx solid #dce5f8;
  border-top-color: var(--brand-600);
  border-radius: 50%;
  animation: loading-spin 0.8s linear infinite;
}

.loading-text {
  margin-top: 24rpx;
  font-size: 25rpx;
}

.not-found-icon {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 50%;
  background: #eaf0ff;
  color: var(--brand-600);
  font-size: 46rpx;
  font-weight: 700;
}

.not-found-title {
  margin-top: 24rpx;
  color: #1f2937;
  font-size: 32rpx;
  font-weight: 650;
}

.not-found-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
}

.archive-retry {
  min-width: 220rpx;
  margin-top: 28rpx;
}

/* 顶部提示 */
.viewer-banner {
  display: flex;
  align-items: center;
  min-height: 76rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(29, 78, 216, 0.08);
  border-radius: 18rpx;
  box-shadow: 0 8rpx 26rpx rgba(25, 48, 86, 0.05);
  box-sizing: border-box;
}

.viewer-live-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #22c77a;
  box-shadow: 0 0 0 8rpx rgba(34, 199, 122, 0.12);
  animation: live-pulse 1.8s ease-out infinite;
}

.viewer-prefix {
  color: #7b8798;
  font-size: 25rpx;
}

.viewer-name {
  color: #17233d;
  font-size: 25rpx;
  font-weight: 650;
}

/* 身份卡 */
.identity-card {
  position: relative;
  overflow: hidden;
  padding: 36rpx 32rpx;
  margin-bottom: 20rpx;
  border-radius: 28rpx;
  color: #fff;
  background: linear-gradient(135deg, #162c5f 0%, #244fb7 57%, #3568e9 100%);
  box-shadow: 0 18rpx 44rpx rgba(25, 65, 156, 0.24);
}

.identity-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.identity-glow-one {
  top: -130rpx;
  right: -70rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(99, 158, 255, 0.26);
}

.identity-glow-two {
  left: 230rpx;
  bottom: -140rpx;
  width: 240rpx;
  height: 240rpx;
  background: rgba(129, 211, 255, 0.12);
}

.identity-main {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.avatar-ring {
  flex: none;
  width: 112rpx;
  height: 112rpx;
  padding: 5rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
  box-sizing: border-box;
}

.avatar-text,
.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, rgba(255,255,255,0.3), rgba(255,255,255,0.12));
  font-size: 48rpx;
  font-weight: 700;
}

.identity-copy {
  min-width: 0;
  margin-left: 26rpx;
}

.identity-name {
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.identity-meta {
  margin-top: 9rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.trust-badge {
  display: inline-flex;
  align-items: center;
  padding: 7rpx 14rpx 7rpx 8rpx;
  margin-top: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.23);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.94);
  font-size: 20rpx;
}

.trust-check {
  width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  text-align: center;
  background: #2dd58a;
  font-size: 18rpx;
  font-weight: 700;
}

/* 人才指数 */
.score-card {
  position: relative;
  overflow: hidden;
  padding: 34rpx 32rpx 0;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(59, 103, 217, 0.1);
  border-radius: 28rpx;
  background: linear-gradient(160deg, #ffffff 0%, #f4f7ff 100%);
  box-shadow: 0 12rpx 36rpx rgba(24, 54, 103, 0.08);
}

.score-card::after {
  content: '';
  position: absolute;
  top: -120rpx;
  right: -100rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(65, 117, 244, 0.14), rgba(65, 117, 244, 0));
}

.score-card-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.eyebrow {
  color: #5270ac;
  font-size: 18rpx;
  font-weight: 650;
  letter-spacing: 3rpx;
}

.score-title {
  margin-top: 4rpx;
  color: #16213a;
  font-size: 31rpx;
  font-weight: 700;
}

.score-caption {
  margin-top: 8rpx;
  color: #8994a8;
  font-size: 21rpx;
}

.score-seal {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  border: 2rpx solid rgba(40, 99, 233, 0.22);
  border-radius: 50%;
  color: #2863e9;
  text-align: center;
  font-size: 19rpx;
  font-weight: 700;
  transform: rotate(8deg);
}

.score-main {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: baseline;
  margin-top: 14rpx;
}

.score-number {
  color: #2057db;
  font-size: 116rpx;
  line-height: 1.05;
  font-weight: 800;
  letter-spacing: -5rpx;
  text-shadow: 0 10rpx 26rpx rgba(43, 92, 255, 0.16);
  transform-origin: left bottom;
}

.score-number--animating {
  animation: score-breathe 0.65s ease-in-out infinite alternate;
}

.score-unit {
  margin-left: 12rpx;
  color: #9aa6ba;
  font-size: 25rpx;
  font-weight: 550;
}

.score-progress-track {
  position: relative;
  z-index: 1;
  height: 12rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e5ebf6;
}

.score-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--brand-600) 0%, #65b8ff 100%);
  box-shadow: 0 0 16rpx rgba(43, 92, 255, 0.45);
}

.score-progress-meta {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  margin-top: 11rpx;
  color: #8994a8;
  font-size: 20rpx;
}

.score-progress-meta text:last-child {
  color: var(--brand-600);
  font-weight: 650;
}

.score-stats {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin: 28rpx -32rpx 0;
  padding: 24rpx 24rpx 26rpx;
  border-top: 1rpx solid rgba(47, 78, 138, 0.08);
  background: rgba(240, 244, 252, 0.5);
}

.score-stat {
  flex: 1;
  text-align: center;
}

.score-stat-value {
  color: #1b2945;
  font-size: 31rpx;
  font-weight: 750;
}

.score-stat-label {
  margin-top: 4rpx;
  color: #8c97aa;
  font-size: 20rpx;
}

.score-stat-divider {
  width: 1rpx;
  height: 44rpx;
  background: #dce3ef;
}

/* 通用区块 */
.section-card {
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(28, 49, 83, 0.045);
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 10rpx 32rpx rgba(24, 49, 88, 0.055);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.section-head--compact {
  margin-bottom: 22rpx;
}

.section-title {
  color: #17233d;
  font-size: 31rpx;
  font-weight: 700;
}

.section-subtitle {
  margin-top: 6rpx;
  color: #98a2b3;
  font-size: 21rpx;
}

.section-count {
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: #eaf0ff;
  color: var(--brand-600);
  font-size: 21rpx;
  font-weight: 650;
}

.section-count--muted {
  background: #f1f4f8;
  color: #7b8799;
}

.module-empty {
  padding: 54rpx 0;
  color: #a1aaba;
  text-align: center;
  font-size: 24rpx;
}

/* 垂直时间轴 */
.timeline-card {
  padding-bottom: 18rpx;
}

.timeline {
  padding-top: 2rpx;
}

.timeline-item {
  position: relative;
  display: grid;
  grid-template-columns: 54rpx 116rpx 1fr;
  column-gap: 14rpx;
  min-height: 142rpx;
}

.timeline-item:last-child {
  min-height: 116rpx;
}

.timeline-line {
  position: absolute;
  top: 46rpx;
  bottom: 0;
  left: 26rpx;
  width: 4rpx;
  border-radius: 4rpx;
  background: #e4e9f1;
}

.timeline-line--done {
  background: linear-gradient(180deg, #21bd73 0%, #7ddbb0 100%);
}

.timeline-marker {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border: 4rpx solid #fff;
  border-radius: 50%;
  box-sizing: border-box;
  background: #dfe5ed;
  color: #99a4b4;
  box-shadow: 0 0 0 2rpx #dfe5ed;
  font-size: 22rpx;
  font-weight: 700;
}

.timeline-item.done .timeline-marker {
  color: #fff;
  background: #21bd73;
  box-shadow: 0 0 0 2rpx rgba(33, 189, 115, 0.24), 0 6rpx 16rpx rgba(33, 189, 115, 0.22);
}

.timeline-item.doing .timeline-marker {
  color: #fff;
  background: var(--brand-600);
  box-shadow: 0 0 0 2rpx rgba(43, 92, 255, 0.22), 0 6rpx 16rpx rgba(43, 92, 255, 0.25);
}

.timeline-rotating {
  display: inline-block;
  animation: timeline-spin 1.7s linear infinite;
}

.timeline-date {
  padding-top: 10rpx;
  color: #8994a7;
  font-size: 23rpx;
  font-weight: 550;
}

.timeline-item.done .timeline-date {
  color: #1a9b60;
}

.timeline-item.doing .timeline-date {
  color: var(--brand-600);
}

.timeline-content {
  padding: 4rpx 0 28rpx;
}

.timeline-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.timeline-title {
  color: #23304a;
  font-size: 27rpx;
  font-weight: 650;
}

.timeline-item.pending .timeline-title {
  color: #8d98aa;
}

.timeline-stage-label {
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  background: #f0f3f7;
  color: #8b95a7;
  font-size: 18rpx;
}

.timeline-item.done .timeline-stage-label {
  background: rgba(33, 189, 115, 0.1);
  color: #14965a;
}

.timeline-item.doing .timeline-stage-label {
  background: rgba(43, 92, 255, 0.09);
  color: var(--brand-600);
}

.timeline-desc {
  margin-top: 8rpx;
  color: #99a3b2;
  font-size: 21rpx;
  line-height: 1.55;
}

.timeline-status {
  display: inline-block;
  margin-top: 8rpx;
  color: #9aa4b3;
  font-size: 19rpx;
}

.timeline-item.done .timeline-status {
  color: #1aa465;
}

.timeline-item.doing .timeline-status {
  color: var(--brand-600);
}

/* 技能标签 */
.skill-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.skill-chip {
  display: flex;
  align-items: center;
  padding: 13rpx 18rpx;
  border: 1rpx solid #dbe5fb;
  border-radius: 12rpx;
  background: #f5f8ff;
  color: #315bb6;
  font-size: 23rpx;
}

.skill-chip-dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #3b70ed;
}

/* 作品动态流 */
.works-section {
  margin-bottom: 24rpx;
}

.works-heading {
  padding: 8rpx 8rpx 0;
  margin-bottom: 22rpx;
}

.work-post {
  position: relative;
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(25, 49, 88, 0.05);
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 10rpx 32rpx rgba(24, 49, 88, 0.06);
}

.post-head {
  display: flex;
  align-items: center;
}

.post-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: linear-gradient(145deg, #315fcf, #183a8e);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}

.post-author-wrap {
  min-width: 0;
  flex: 1;
  margin-left: 18rpx;
}

.post-author {
  color: #264b9b;
  font-size: 26rpx;
  font-weight: 650;
}

.post-time {
  margin-top: 4rpx;
  color: #a2aab7;
  font-size: 19rpx;
}

.post-more {
  padding: 12rpx 4rpx 12rpx 20rpx;
  color: #8c96a7;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.post-title {
  margin-top: 24rpx;
  color: #17233d;
  font-size: 30rpx;
  line-height: 1.45;
  font-weight: 700;
}

.post-desc {
  margin-top: 10rpx;
  color: #566177;
  font-size: 24rpx;
  line-height: 1.65;
}

.post-cover,
.post-cover-placeholder {
  width: 100%;
  height: 330rpx;
  margin-top: 22rpx;
  border-radius: 16rpx;
}

.post-cover {
  display: block;
  background: #edf1f7;
}

.post-cover-placeholder {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #203b7d 0%, #3263cd 60%, #5a8cff 100%);
  color: #fff;
}

.placeholder-grid {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  opacity: 0.16;
  background-image: linear-gradient(rgba(255,255,255,0.45) 1rpx, transparent 1rpx), linear-gradient(90deg, rgba(255,255,255,0.45) 1rpx, transparent 1rpx);
  background-size: 50rpx 50rpx;
  transform: perspective(360rpx) rotateX(56deg) scale(1.5) translateY(70rpx);
}

.placeholder-mark {
  position: relative;
  z-index: 1;
  font-size: 84rpx;
  line-height: 1;
  font-weight: 800;
  text-shadow: 0 12rpx 30rpx rgba(6, 20, 58, 0.24);
}

.placeholder-copy {
  position: relative;
  z-index: 1;
  margin-top: 16rpx;
  color: rgba(255,255,255,0.72);
  font-size: 18rpx;
  letter-spacing: 5rpx;
}

.post-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
}

.post-category {
  color: #99a2b1;
  font-size: 20rpx;
}

.evidence-trigger {
  display: flex;
  align-items: center;
  padding: 8rpx 14rpx;
  border: 1rpx solid #cfe0d8;
  border-radius: 999rpx;
  background: #f2faf6;
  color: #168956;
  font-size: 20rpx;
  transition: all 0.2s ease;
}

.evidence-trigger--hover,
.evidence-trigger--open {
  border-color: #24aa6d;
  background: #e8f8f0;
  transform: translateY(-1rpx);
}

.lock-icon {
  position: relative;
  width: 24rpx;
  height: 26rpx;
  margin-right: 8rpx;
}

.lock-shackle {
  position: absolute;
  top: 0;
  left: 6rpx;
  width: 12rpx;
  height: 14rpx;
  border: 3rpx solid #1a9c61;
  border-bottom: 0;
  border-radius: 8rpx 8rpx 0 0;
  box-sizing: border-box;
}

.lock-body {
  position: absolute;
  left: 2rpx;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20rpx;
  height: 16rpx;
  border-radius: 4rpx;
  background: #1a9c61;
}

.lock-keyhole {
  width: 3rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #fff;
}

.hash-popover {
  position: relative;
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 5rpx 14rpx;
  padding: 20rpx;
  margin-top: 14rpx;
  border: 1rpx solid #dce9e2;
  border-radius: 14rpx;
  background: #f5fbf8;
  transition: background 0.2s ease;
  animation: hash-in 0.22s ease-out;
}

.hash-popover--hover {
  background: #ecf8f2;
}

.hash-popover-arrow {
  position: absolute;
  top: -8rpx;
  right: 54rpx;
  width: 14rpx;
  height: 14rpx;
  border-top: 1rpx solid #dce9e2;
  border-left: 1rpx solid #dce9e2;
  background: #f5fbf8;
  transform: rotate(45deg);
}

.hash-label {
  color: #6e7d76;
  font-size: 20rpx;
  font-weight: 650;
}

.hash-value {
  min-width: 0;
  color: #187e52;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 20rpx;
  text-align: right;
  word-break: break-all;
}

.hash-copy {
  grid-column: 1 / 3;
  color: #9aa8a1;
  font-size: 18rpx;
  text-align: right;
}

/* 认证 */
.cert-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf0f4;
}

.cert-item:last-child {
  border-bottom: 0;
}

.cert-icon {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 16rpx;
  background: linear-gradient(145deg, #fff5da, #ffe7a6);
  color: #a97000;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
}

.cert-copy {
  min-width: 0;
  flex: 1;
  margin-left: 18rpx;
}

.cert-name {
  color: #243047;
  font-size: 26rpx;
  font-weight: 650;
}

.cert-meta {
  margin-top: 5rpx;
  color: #98a1b0;
  font-size: 20rpx;
}

.verified-pill {
  display: inline-flex;
  flex: none;
  align-items: center;
  padding: 7rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(28, 174, 105, 0.1);
  color: #16945a;
  font-size: 19rpx;
}

/* 企业评价 */
.eval-item {
  padding: 26rpx 0;
  border-bottom: 1rpx solid #edf0f4;
}

.eval-item:first-child {
  padding-top: 8rpx;
}

.eval-item:last-child {
  padding-bottom: 4rpx;
  border-bottom: 0;
}

.eval-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.eval-company {
  color: #243047;
  font-size: 27rpx;
  font-weight: 700;
}

.eval-mentor {
  margin-top: 5rpx;
  color: #9aa3b2;
  font-size: 20rpx;
}

.eval-score {
  color: #eb9d15;
  font-size: 19rpx;
}

.eval-score text {
  font-size: 34rpx;
  font-weight: 750;
}

.eval-quote {
  padding: 20rpx 22rpx;
  margin-top: 18rpx;
  border-left: 5rpx solid #dbe6fc;
  border-radius: 0 12rpx 12rpx 0;
  background: #f7f9fc;
  color: #566177;
  font-size: 23rpx;
  line-height: 1.7;
}

.eval-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 15rpx;
}

/* 页脚 */
.archive-footer {
  padding: 36rpx 20rpx 18rpx;
  color: #9ba5b5;
  text-align: center;
}

.footer-chain {
  display: flex;
  align-items: center;
  justify-content: center;
}

.footer-chain-line {
  width: 52rpx;
  height: 1rpx;
  background: #cdd4df;
}

.footer-chain-dot {
  width: 10rpx;
  height: 10rpx;
  margin: 0 14rpx;
  border: 3rpx solid #9eb1d5;
  border-radius: 50%;
}

.footer-title {
  margin-top: 15rpx;
  color: #718099;
  font-size: 22rpx;
  font-weight: 650;
}

.footer-tip {
  margin-top: 7rpx;
  font-size: 19rpx;
}

@keyframes loading-spin {
  to { transform: rotate(360deg); }
}

@keyframes timeline-spin {
  to { transform: rotate(360deg); }
}

@keyframes live-pulse {
  0% { box-shadow: 0 0 0 0 rgba(34, 199, 122, 0.28); }
  70% { box-shadow: 0 0 0 12rpx rgba(34, 199, 122, 0); }
  100% { box-shadow: 0 0 0 0 rgba(34, 199, 122, 0); }
}

@keyframes score-breathe {
  from { transform: scale(0.985); }
  to { transform: scale(1.02); }
}

@keyframes hash-in {
  from { opacity: 0; transform: translateY(-8rpx); }
  to { opacity: 1; transform: translateY(0); }
}
