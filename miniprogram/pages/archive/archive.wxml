<view wx:if="{{loading}}" class="loading-state">
  <view class="loading-ring"></view>
  <view class="loading-text">正在读取数字档案</view>
</view>

<view wx:elif="{{notFound}}" class="not-found">
  <view class="not-found-icon">!</view>
  <view class="not-found-title">未找到该档案</view>
  <view class="not-found-desc">请确认二维码是否有效后重试</view>
</view>

<view wx:elif="{{error}}" class="not-found">
  <view class="not-found-icon">!</view>
  <view class="not-found-title">档案暂时没有加载出来</view>
  <view class="not-found-desc">{{errorMessage}}</view>
  <button class="ui-btn ui-btn--primary ui-btn--medium archive-retry" bindtap="retryLoad" hover-class="ui-btn--pressed">重新加载</button>
</view>

<view wx:else class="archive-page">
  <!-- 顶部查看提示 -->
  <view class="viewer-banner">
    <view class="viewer-live-dot"></view>
    <text class="viewer-prefix">正在查看：</text>
    <text class="viewer-name">{{user.name || '未命名工匠'}}的数字档案</text>
  </view>

  <!-- 身份摘要 -->
  <view class="identity-card">
    <view class="identity-glow identity-glow-one"></view>
    <view class="identity-glow identity-glow-two"></view>
    <view class="identity-main">
      <view class="avatar-ring">
        <image wx:if="{{user.avatar}}" class="avatar-image" src="{{user.avatar}}" mode="aspectFill" />
        <view wx:else class="avatar-text">{{userInitial}}</view>
      </view>
      <view class="identity-copy">
        <view class="identity-name">{{user.name || '未命名工匠'}}</view>
        <view class="identity-meta">{{user.school || '未填写学校'}} · {{user.major || '未填写专业'}}</view>
        <view class="trust-badge">
          <view class="trust-check">✓</view>
          <text>档案已建立 · 记录可追溯</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 关键数据 -->
  <view class="score-card">
    <view class="score-card-top">
      <view>
        <view class="eyebrow">TALENT INDEX</view>
        <view class="score-title">人才指数</view>
        <view class="score-caption">基于技能、作品、认证与企业评价综合计算</view>
      </view>
      <view class="score-seal">已记录</view>
    </view>

    <view class="score-main">
      <view class="score-number {{scoreAnimating ? 'score-number--animating' : ''}}">{{talentIndexDisplay}}</view>
      <view class="score-unit">/ 100</view>
    </view>

    <view class="score-progress-track">
      <view class="score-progress-fill" style="width: {{talentProgress}}%;"></view>
    </view>
    <view class="score-progress-meta">
      <text>成长值持续更新</text>
      <text>{{scoreLevel}}</text>
    </view>

    <view class="score-stats">
      <view class="score-stat">
        <view class="score-stat-value">{{works.length}}</view>
        <view class="score-stat-label">哈希作品</view>
      </view>
      <view class="score-stat-divider"></view>
      <view class="score-stat">
        <view class="score-stat-value">{{certifications.length}}</view>
        <view class="score-stat-label">技能认证</view>
      </view>
      <view class="score-stat-divider"></view>
      <view class="score-stat">
        <view class="score-stat-value">{{evaluations.length}}</view>
        <view class="score-stat-label">企业评价</view>
      </view>
    </view>
  </view>

  <!-- 五阶段成长路径 -->
  <view class="section-card timeline-card">
    <view class="section-head">
      <view>
        <view class="section-title">五阶段成长路径</view>
        <view class="section-subtitle">每一步成长都有迹可循</view>
      </view>
      <view class="section-count">{{completedStageCount}} / 5</view>
    </view>

    <view class="timeline">
      <view class="timeline-item {{item.status}}" wx:for="{{timeline}}" wx:key="stage">
        <view wx:if="{{index < timeline.length - 1}}" class="timeline-line {{item.lineDone ? 'timeline-line--done' : ''}}"></view>
        <view class="timeline-marker">
          <text wx:if="{{item.status === 'done'}}">✓</text>
          <text wx:elif="{{item.status === 'doing'}}" class="timeline-rotating">↻</text>
          <text wx:else>{{index + 1}}</text>
        </view>
        <view class="timeline-date">{{item.dateLabel}}</view>
        <view class="timeline-content">
          <view class="timeline-title-row">
            <view class="timeline-title">{{item.title}}</view>
            <view class="timeline-stage-label">{{item.stage}}</view>
          </view>
          <view class="timeline-desc">{{item.description}}</view>
          <view class="timeline-status">{{item.statusLabel}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 技能档案 -->
  <view class="section-card skill-card">
    <view class="section-head section-head--compact">
      <view class="section-title">技能档案</view>
      <view class="section-count section-count--muted">{{user.skillTags.length || 0}} 项</view>
    </view>
    <view wx:if="{{user.skillTags.length}}" class="skill-list">
      <view class="skill-chip" wx:for="{{user.skillTags}}" wx:key="*this">
        <view class="skill-chip-dot"></view>
        <text>{{item}}</text>
      </view>
    </view>
    <view wx:else class="module-empty">暂无技能标签</view>
  </view>

  <!-- 朋友圈式作品展示流 -->
  <view class="works-section">
    <view class="section-head works-heading">
      <view>
        <view class="section-title">作品动态</view>
        <view class="section-subtitle">他的每一次创作与成长</view>
      </view>
      <view class="section-count section-count--muted">{{works.length}} 件</view>
    </view>

    <view wx:if="{{works.length}}">
      <view class="work-post" wx:for="{{works}}" wx:key="_id">
        <view class="post-head">
          <view class="post-avatar">{{userInitial}}</view>
          <view class="post-author-wrap">
            <view class="post-author">{{user.name || '未命名工匠'}}</view>
            <view class="post-time">{{item.createdLabel}}</view>
          </view>
          <view class="post-more">•••</view>
        </view>

        <view class="post-title">{{item.title}}</view>
        <view wx:if="{{item.desc}}" class="post-desc">{{item.desc}}</view>

        <image wx:if="{{item.coverUrl}}" class="post-cover" src="{{item.coverUrl}}" mode="aspectFill" />
        <view wx:else class="post-cover-placeholder">
          <view class="placeholder-grid"></view>
          <view class="placeholder-mark">{{item.titleInitial}}</view>
          <view class="placeholder-copy">DIGITAL WORK</view>
        </view>

        <view class="post-footer">
          <view class="post-category">原创作品</view>
          <view
            class="evidence-trigger {{item.hashVisible ? 'evidence-trigger--open' : ''}}"
            data-index="{{index}}"
            catchtap="toggleHash"
            hover-class="evidence-trigger--hover"
          >
            <view class="lock-icon">
              <view class="lock-shackle"></view>
              <view class="lock-body"><view class="lock-keyhole"></view></view>
            </view>
            <text>哈希记录</text>
          </view>
        </view>

        <view
          wx:if="{{item.hashVisible}}"
          class="hash-popover"
          data-index="{{index}}"
          catchtap="copyHash"
          hover-class="hash-popover--hover"
        >
          <view class="hash-popover-arrow"></view>
          <view class="hash-label">哈希值</view>
          <view class="hash-value">{{item.displayHash}}</view>
          <view class="hash-copy">点击复制完整哈希</view>
        </view>
      </view>
    </view>
    <view wx:else class="section-card module-empty">暂无作品动态</view>
  </view>

  <!-- 认证记录 -->
  <view class="section-card">
    <view class="section-head section-head--compact">
      <view class="section-title">认证记录</view>
      <view class="section-count section-count--muted">{{certifications.length}} 项</view>
    </view>
    <view wx:if="{{certifications.length}}">
      <view class="cert-item" wx:for="{{certifications}}" wx:key="_id">
        <view class="cert-icon">证</view>
        <view class="cert-copy">
          <view class="cert-name">{{item.certName}}</view>
          <view class="cert-meta">{{item.issuer}} · {{item.level}}</view>
        </view>
        <view class="verified-pill">✓ 凭证已记录</view>
      </view>
    </view>
    <view wx:else class="module-empty">暂无认证记录</view>
  </view>

  <!-- 企业评价 -->
  <view class="section-card">
    <view class="section-head section-head--compact">
      <view class="section-title">企业评价</view>
      <view class="section-count section-count--muted">{{evaluations.length}} 条</view>
    </view>
    <view wx:if="{{evaluations.length}}">
      <view class="eval-item" wx:for="{{evaluations}}" wx:key="_id">
        <view class="eval-head">
          <view>
            <view class="eval-company">{{item.companyName}}</view>
            <view class="eval-mentor">企业导师 · {{item.mentorName}}</view>
          </view>
          <view class="eval-score"><text>{{item.score}}</text> 分</view>
        </view>
        <view class="eval-quote">“{{item.content}}”</view>
        <view class="eval-badges">
          <view class="verified-pill">✓ 平台完整性校验</view>
          <view class="verified-pill">✓ 哈希记录</view>
        </view>
      </view>
    </view>
    <view wx:else class="module-empty">暂无企业评价</view>
  </view>

  <view class="archive-footer">
    <view class="footer-chain">
      <view class="footer-chain-line"></view>
      <view class="footer-chain-dot"></view>
      <view class="footer-chain-line"></view>
    </view>
    <view class="footer-title">数字工匠数字档案</view>
    <view class="footer-tip">档案数据已生成哈希摘要，可用于内容完整性校验</view>
  </view>
</view>
