<view class="password-page">
  <view class="password-hero">
    <view class="password-icon">密</view>
    <view class="password-title">{{firstSetup ? '设置你的个人密码' : role === 'enterprise' ? '修改企业密码' : '修改登录密码'}}</view>
    <view class="password-desc">
      {{firstSetup ? '初始密码仅用于首次激活，请先设置新密码再进入档案' : '修改后旧密码及其他旧会话将立即失效'}}
    </view>
  </view>

  <view class="password-card">
    <view wx:if="{{!firstSetup}}" class="password-field">
      <view class="field-title">原密码</view>
      <view class="password-input-shell">
        <input
          class="password-input"
          value="{{currentPassword}}"
          password="{{!currentVisible}}"
          maxlength="32"
          placeholder="请输入当前登录密码"
          bindinput="onCurrentInput"
        />
        <view class="visibility" bindtap="toggleCurrent" hover-class="ui-link--pressed">{{currentVisible ? '隐藏' : '显示'}}</view>
      </view>
    </view>

    <view class="password-field">
      <view class="field-title">新密码</view>
      <view class="password-input-shell">
        <input
          class="password-input"
          value="{{newPassword}}"
          password="{{!newVisible}}"
          maxlength="32"
          placeholder="请输入 8—32 位新密码"
          bindinput="onNewInput"
        />
        <view class="visibility" bindtap="toggleNew" hover-class="ui-link--pressed">{{newVisible ? '隐藏' : '显示'}}</view>
      </view>
    </view>

    <view class="password-field">
      <view class="field-title">确认新密码</view>
      <view class="password-input-shell">
        <input
          class="password-input"
          value="{{confirmPassword}}"
          password="{{!confirmVisible}}"
          maxlength="32"
          placeholder="请再次输入新密码"
          confirm-type="done"
          bindinput="onConfirmInput"
          bindconfirm="submitPassword"
        />
        <view class="visibility" bindtap="toggleConfirm" hover-class="ui-link--pressed">{{confirmVisible ? '隐藏' : '显示'}}</view>
      </view>
    </view>

    <view class="password-rules">
      <view>• 长度为 8—32 位</view>
      <view>• 必须同时包含字母和数字</view>
      <view>• 不能包含空格，不能与原密码相同</view>
    </view>

    <button
      class="ui-btn ui-btn--primary ui-btn--block password-submit"
      bindtap="submitPassword"
      loading="{{saving}}"
      disabled="{{saving}}"
      hover-class="ui-btn--pressed"
      hover-start-time="20"
      hover-stay-time="90"
    >
      <text class="ui-button__label">{{firstSetup ? '设置密码并继续' : '确认修改密码'}}</text>
      <text class="ui-button__arrow">→</text>
    </button>
  </view>

  <view class="password-security">密码在云端加盐哈希保存，平台不会保存或展示明文密码</view>
</view>
