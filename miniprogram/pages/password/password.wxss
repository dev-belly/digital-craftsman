page {
  background: #f5f7fb;
}

.password-page {
  min-height: 100vh;
  padding: 34rpx 36rpx 58rpx;
  box-sizing: border-box;
}

.password-hero {
  padding: 38rpx 18rpx 36rpx;
  text-align: center;
}

.password-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto;
  border-radius: 24rpx;
  background: var(--brand-600);
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 24rpx rgba(36, 87, 214, 0.18);
}

.password-title {
  margin-top: 26rpx;
  color: #17233d;
  font-size: 38rpx;
  font-weight: 700;
}

.password-desc {
  max-width: 590rpx;
  margin: 13rpx auto 0;
  color: #8290a5;
  font-size: 23rpx;
  line-height: 1.65;
}

.password-card {
  padding: 38rpx 32rpx 34rpx;
  border: 1rpx solid rgba(218, 226, 239, 0.8);
  border-radius: 24rpx;
  background: #fff;
  box-shadow: var(--shadow-card);
}

.password-field {
  margin-top: 27rpx;
}

.password-field:first-child {
  margin-top: 0;
}

.field-title {
  margin-bottom: 12rpx;
  color: #334057;
  font-size: 24rpx;
  font-weight: 600;
}

.password-input-shell {
  display: flex;
  align-items: center;
  height: 92rpx;
  padding: 0 22rpx;
  border: 1rpx solid #dfe5ee;
  border-radius: 16rpx;
  background: #f8fafc;
  box-sizing: border-box;
}

.password-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  color: #1d2a40;
  font-size: 27rpx;
}

.visibility {
  flex: none;
  padding: 16rpx 0 16rpx 18rpx;
  color: var(--brand-600);
  font-size: 22rpx;
}

.password-rules {
  padding: 20rpx 22rpx;
  margin-top: 26rpx;
  border: 1rpx solid #e3eaf5;
  border-radius: 16rpx;
  background: #f3f6fb;
  color: #71809a;
  font-size: 21rpx;
  line-height: 1.9;
}

.password-submit {
  margin-top: 30rpx;
}

.password-security {
  margin-top: 30rpx;
  color: #929dac;
  text-align: center;
  font-size: 20rpx;
}
