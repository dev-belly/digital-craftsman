.account-binding-card {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 24rpx;
  background: linear-gradient(135deg, #1c479f, #2d67d1);
  color: #fff;
  box-shadow: 0 10rpx 28rpx rgba(31, 74, 158, 0.16);
}
.account-binding-icon {
  width: 54rpx;
  height: 54rpx;
  line-height: 54rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
}
.account-binding-copy {
  flex: 1;
  margin-left: 20rpx;
}
.account-binding-title {
  font-size: 24rpx;
  font-weight: 600;
}
.account-binding-value {
  margin-top: 5rpx;
  color: rgba(255, 255, 255, 0.75);
  font-size: 21rpx;
  letter-spacing: 2rpx;
}
.account-binding-badge {
  padding: 7rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  font-size: 19rpx;
}

.field {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef1f5;
}
.label {
  width: 120rpx;
  color: var(--text-sub);
  font-size: 28rpx;
}
.input {
  flex: 1;
  color: var(--text-900);
  font-size: 28rpx;
}
.tag-add {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  gap: 16rpx;
}
.tag-add .input {
  min-height: 68rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  background: var(--surface-soft);
  padding: 16rpx 20rpx;
}
.add-btn {
  flex: none;
}
.tag--pressed {
  opacity: 0.65;
}
.save-btn {
  margin-top: 4rpx;
}
.visibility-card {
  border: 1rpx solid #dce6f8;
}
.visibility-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.visibility-copy {
  flex: 1;
  min-width: 0;
}
.visibility-title {
  margin-bottom: 8rpx;
}
.visibility-desc,
.visibility-tip {
  color: var(--text-sub);
  font-size: 22rpx;
  line-height: 1.55;
}

.visibility-divider {
  height: 1rpx;
  margin: 24rpx 0;
  background: #edf1f6;
}
.visibility-tip {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf1f7;
  color: #8d97a6;
}
.policy-card {
  margin-top: 24rpx;
  padding: 0 32rpx;
}
.policy-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  color: var(--text-main);
  font-size: 28rpx;
  border-bottom: 1rpx solid #eef1f5;
  transition: background-color 120ms ease;
}
.policy-row:last-child { border-bottom: none; }
.policy-row--pressed {
  background: #f5f7fb;
}
.policy-copy {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}
.policy-hint {
  color: #9aa4b3;
  font-size: 20rpx;
}
.policy-arrow {
  color: #a0a7b5;
  font-size: 42rpx;
  line-height: 1;
}
.logout {
  margin-top: 20rpx;
}
.logout-tip {
  margin: 14rpx 0 24rpx;
  color: #9aa4b3;
  text-align: center;
  font-size: 20rpx;
}

@keyframes state-spin {
  to { transform: rotate(360deg); }
}
.profile-state {
  min-height: 76vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 56rpx;
  box-sizing: border-box;
  text-align: center;
}

.state-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 5rpx solid #dbe5f8;
  border-top-color: var(--brand-600);
  border-radius: 50%;
  animation: state-spin 0.8s linear infinite;
}

.state-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 23rpx;
  background: #eaf0ff;
  color: var(--brand-600);
  font-size: 35rpx;
  font-weight: 700;
}

.state-title {
  margin-top: 22rpx;
  color: var(--text-700);
  font-size: 28rpx;
  font-weight: 650;
}

.state-desc {
  margin-top: 9rpx;
  color: var(--text-400);
  font-size: 22rpx;
}

.retry-btn {
  min-width: 220rpx;
  margin-top: 26rpx;
}
