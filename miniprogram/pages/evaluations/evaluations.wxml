<view class="container">
  <view class="page-summary">
    <view>
      <view class="page-title">成长反馈</view>
      <view class="page-desc">企业导师评价已生成平台校验码与哈希记录</view>
    </view>
    <view class="summary-count">{{evals.length}}<text>条</text></view>
  </view>

  <view wx:if="{{loading}}" class="page-state">
    <view class="state-spinner"></view>
    <view class="state-title">正在同步企业评价</view>
  </view>

  <view wx:elif="{{error}}" class="page-state">
    <view class="state-icon">!</view>
    <view class="state-title">评价暂时没有加载出来</view>
    <view class="state-desc">{{error}}</view>
    <button class="ui-btn ui-btn--primary ui-btn--medium retry-btn" bindtap="load" hover-class="ui-btn--pressed">重新加载</button>
  </view>

  <block wx:else>
    <view class="card eval-card" wx:for="{{evals}}" wx:key="_id">
      <view class="eval-head">
        <view class="company-avatar">企</view>
        <view class="company-copy">
          <view class="company-name">{{item.companyName}}</view>
          <view class="company-label">企业导师评价</view>
        </view>
        <view class="score-badge">
          <text class="score-number">{{item.score}}</text>
          <text class="score-unit">分</text>
        </view>
      </view>

      <view class="eval-content">{{item.content}}</view>

      <view class="eval-footer">
        <view class="mentor">
          <view class="mentor-dot"></view>
          <text>导师：{{item.mentorName || '企业导师'}}</text>
        </view>
        <view class="proof-row">
          <text class="proof-badge">✓ 平台完整性校验</text>
          <view
            class="proof-badge proof-badge--action"
            data-index="{{index}}"
            bindtap="toggleHash"
            hover-class="proof-badge--pressed"
          >
            {{item.evidenceHash ? (item.hashVisible ? '哈希记录 · 收起' : '哈希记录 · 查看') : '哈希记录待生成'}}
          </view>
        </view>
        <view
          wx:if="{{item.hashVisible && item.evidenceHash}}"
          class="hash-detail"
          data-index="{{index}}"
          catchtap="copyHash"
          hover-class="hash-detail--pressed"
        >
          <view class="hash-detail-label">评价证据哈希</view>
          <view class="hash-detail-value">{{item.fullHash}}</view>
          <view class="hash-detail-copy">点击复制完整哈希</view>
        </view>
      </view>
    </view>

    <view wx:if="{{!evals.length}}" class="empty-state">
      <view class="empty-icon">评</view>
      <view class="empty-title">暂无企业评价</view>
      <view class="empty-desc">参与实训或项目后，企业反馈会沉淀在这里</view>
    </view>
  </block>
</view>
