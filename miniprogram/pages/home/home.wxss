page {
  background: #f3f6fb;
}

.home-page {
  padding-bottom: calc(38rpx + env(safe-area-inset-bottom));
}

.home-state {
  min-height: 76vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 56rpx;
  box-sizing: border-box;
  text-align: center;
}

.state-spinner {
  width: 52rpx;
  height: 52rpx;
  border: 5rpx solid #dbe5f8;
  border-top-color: var(--brand-600);
  border-radius: 50%;
  animation: state-spin 0.8s linear infinite;
}

.state-icon {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 50%;
  background: #eaf0ff;
  color: var(--brand-600);
  font-size: 44rpx;
  font-weight: 700;
}

.state-title {
  margin-top: 25rpx;
  color: var(--text-900);
  font-size: 31rpx;
  font-weight: 700;
}

.state-desc {
  max-width: 520rpx;
  margin-top: 10rpx;
  color: var(--text-500);
  font-size: 23rpx;
  line-height: 1.6;
}

.retry-btn {
  min-width: 230rpx;
  margin-top: 30rpx;
}

.identity-card {
  position: relative;
  overflow: hidden;
  padding: 32rpx 30rpx 24rpx;
  margin-bottom: 22rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #173a84 0%, #2457bc 58%, #3775e8 100%);
  color: #fff;
  box-shadow: 0 16rpx 38rpx rgba(30, 75, 166, 0.22);
}

.identity-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.identity-glow--one {
  top: -130rpx;
  right: -70rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(117, 179, 255, 0.25);
}

.identity-glow--two {
  left: 260rpx;
  bottom: -150rpx;
  width: 260rpx;
  height: 260rpx;
  background: rgba(167, 218, 255, 0.1);
}

.identity-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.avatar {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.36);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  font-size: 39rpx;
  font-weight: 700;
}

.identity-copy {
  flex: 1;
  min-width: 0;
  margin-left: 21rpx;
}

.welcome {
  color: rgba(255, 255, 255, 0.7);
  font-size: 20rpx;
}

.name {
  margin-top: 3rpx;
  overflow: hidden;
  font-size: 34rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta {
  margin-top: 6rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.76);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.index-box {
  flex: none;
  min-width: 104rpx;
  margin-left: 15rpx;
  text-align: center;
}

.index-num {
  font-size: 52rpx;
  line-height: 1;
  font-weight: 800;
}

.index-label {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 19rpx;
}

.identity-foot {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  margin-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.72);
  font-size: 19rpx;
}

.identity-trust {
  display: flex;
  align-items: center;
}

.trust-dot {
  width: 11rpx;
  height: 11rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #58e6a3;
  box-shadow: 0 0 0 6rpx rgba(88, 230, 163, 0.12);
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.quick-card {
  position: relative;
  min-width: 0;
  padding: 22rpx 18rpx 20rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.9);
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(29, 49, 82, 0.055);
  transition: transform 120ms ease, opacity 120ms ease;
}

.quick-card--pressed {
  opacity: 0.86;
  transform: scale(0.97);
}

.quick-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 12rpx;
  background: #eef4ff;
  color: var(--brand-600);
  font-size: 19rpx;
  font-weight: 700;
}

.quick-icon--cert {
  background: #edf9f3;
  color: var(--success-600);
}

.quick-icon--eval {
  background: #fff5e6;
  color: var(--gold-600);
}

.quick-value {
  margin-top: 17rpx;
  color: var(--text-900);
  font-size: 37rpx;
  line-height: 1;
  font-weight: 750;
}

.quick-label {
  margin-top: 7rpx;
  color: var(--text-500);
  font-size: 20rpx;
}

.quick-arrow {
  position: absolute;
  right: 16rpx;
  bottom: 17rpx;
  color: #b2bac7;
  font-size: 32rpx;
}

.qr-card,
.growth-card,
.invitation-card,
.opportunity-card,
.skill-card {
  padding: 29rpx 30rpx;
}

.opportunity-count {
  flex: none;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: #edf9f3;
  color: #168759;
  font-size: 19rpx;
  font-weight: 650;
}

.opportunity-item {
  padding: 24rpx 0;
  border-top: 1rpx solid #edf1f6;
}

.opportunity-item:first-child {
  padding-top: 0;
  border-top: 0;
}

.opportunity-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.opportunity-company {
  overflow: hidden;
  color: #5c6f8e;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.opportunity-type {
  flex: none;
  padding: 6rpx 13rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #3464bd;
  font-size: 18rpx;
}

.opportunity-type--training {
  background: #fff4df;
  color: #a86500;
}

.opportunity-type--fulltime {
  background: #edf9f3;
  color: #168759;
}

.opportunity-title {
  margin-top: 10rpx;
  color: var(--text-900);
  font-size: 27rpx;
  font-weight: 700;
}

.opportunity-meta,
.opportunity-desc {
  margin-top: 8rpx;
  color: var(--text-400);
  font-size: 20rpx;
  line-height: 1.5;
}

.opportunity-desc {
  color: #5d6d83;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.opportunity-action {
  margin-top: 18rpx;
  border: 0;
  background: #2457d6;
  color: #fff;
}

.opportunity-action--pending,
.opportunity-action--accepted,
.opportunity-action--declined {
  background: #f2f5f9;
  color: #60718a;
  box-shadow: none;
}

.opportunity-action--accepted {
  background: #eaf8f1;
  color: #168759;
}

.opportunity-action--declined {
  background: #f8f1f1;
  color: #a85757;
}

.opportunity-empty {
  padding: 32rpx 20rpx;
  border-radius: 16rpx;
  background: #f7f9fc;
  color: #8b96a7;
  font-size: 21rpx;
  text-align: center;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  color: var(--text-900);
  font-size: 29rpx;
  font-weight: 700;
}

.section-desc {
  margin-top: 7rpx;
  color: var(--text-400);
  font-size: 20rpx;
  line-height: 1.45;
}

.version-pill,
.progress-pill,
.skill-count {
  flex: none;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: #eef3ff;
  color: var(--brand-600);
  font-size: 19rpx;
  font-weight: 650;
}

.qr-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 5rpx;
  border: 1rpx solid #e7ecf4;
  border-radius: 20rpx;
  background: #f8fafd;
}

.wxa-code-img,
.qr-state {
  width: 332rpx;
  height: 332rpx;
}

.wxa-code-img {
  transition: transform 120ms ease, opacity 120ms ease;
}

.qr-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #71809b;
}

.qr-state--error {
  background: #f5f7fb;
  color: #52698f;
}

.qr-code--pressed {
  opacity: 0.86;
  transform: scale(0.985);
}

.qr-loading {
  width: 44rpx;
  height: 44rpx;
  border: 5rpx solid #dbe5f7;
  border-top-color: var(--brand-600);
  border-radius: 50%;
  animation: state-spin 0.8s linear infinite;
}

.qr-retry-icon {
  color: var(--brand-600);
  font-size: 50rpx;
}

.qr-state-text {
  max-width: 280rpx;
  margin-top: 17rpx;
  font-size: 21rpx;
  line-height: 1.5;
  text-align: center;
}

.qr-tip {
  padding: 13rpx 0 17rpx;
  color: #8d98aa;
  font-size: 19rpx;
}

.qr-version-notice {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 20rpx;
  margin: 20rpx 0 0;
  border: 1rpx solid #f2d7a1;
  border-radius: 16rpx;
  background: #fff9ed;
  color: #805d20;
  font-size: 22rpx;
  line-height: 1.6;
}

.qr-version-notice__icon {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  margin: 2rpx 12rpx 0 0;
  border-radius: 50%;
  background: #e8a321;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
}

.archive-btn {
  height: 76rpx;
  margin-top: 18rpx;
}

.archive-arrow {
  margin-left: 11rpx;
  font-size: 25rpx;
}

.stage-track {
  display: flex;
  align-items: flex-start;
  padding: 8rpx 0 14rpx;
}

.stage-node {
  flex: none;
  width: 72rpx;
  text-align: center;
}

.stage-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin: 0 auto;
  border: 2rpx solid #dde3ec;
  border-radius: 50%;
  background: #f4f6f9;
  color: #9aa5b5;
  font-size: 19rpx;
  box-sizing: border-box;
}

.stage-dot.done {
  border-color: var(--success-600);
  background: var(--success-600);
  color: #fff;
}

.stage-dot.doing {
  border-color: var(--brand-600);
  background: var(--brand-600);
  color: #fff;
  box-shadow: 0 0 0 7rpx rgba(36, 87, 214, 0.1);
}

.stage-name {
  margin-top: 10rpx;
  color: #8b96a7;
  font-size: 19rpx;
  white-space: nowrap;
}

.stage-name.done {
  color: var(--success-600);
}

.stage-name.doing {
  color: var(--brand-600);
  font-weight: 650;
}

.stage-line {
  flex: 1;
  height: 3rpx;
  margin-top: 21rpx;
  background: #e2e7ef;
}

.stage-line.done {
  background: #74cfa7;
}

.current-stage {
  display: grid;
  grid-template-columns: auto auto 1fr;
  align-items: center;
  column-gap: 12rpx;
  padding: 17rpx 18rpx;
  margin-top: 13rpx;
  border-radius: 15rpx;
  background: #f4f7fc;
}

.current-stage-label {
  padding: 5rpx 10rpx;
  border-radius: 8rpx;
  background: #e5edff;
  color: var(--brand-600);
  font-size: 18rpx;
}

.current-stage-name {
  color: var(--text-900);
  font-size: 23rpx;
  font-weight: 700;
}

.current-stage-hint {
  overflow: hidden;
  color: var(--text-400);
  font-size: 19rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.invite-count {
  min-width: 35rpx;
  height: 35rpx;
  line-height: 35rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #fff0f0;
  color: var(--danger-600);
  font-size: 19rpx;
  font-weight: 700;
  text-align: center;
}

.invite-item {
  padding: 22rpx 0;
  border-top: 1rpx solid #edf1f5;
}

.invite-item:first-of-type {
  padding-top: 0;
  border-top: 0;
}

.invite-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.invite-company {
  color: var(--text-900);
  font-size: 27rpx;
  font-weight: 700;
}

.invite-status {
  padding: 5rpx 11rpx;
  border-radius: 999rpx;
  background: #fff6e8;
  color: var(--gold-600);
  font-size: 18rpx;
}

.invite-status--accepted {
  background: #edf9f3;
  color: var(--success-600);
}

.invite-status--declined {
  background: #f1f3f6;
  color: #7f8997;
}

.invite-type {
  display: inline-flex;
  padding: 5rpx 12rpx;
  margin-top: 12rpx;
  border-radius: 8rpx;
  font-size: 19rpx;
}

.invite-interview {
  background: #eaf0ff;
  color: var(--brand-600);
}

.invite-intern {
  background: #fff4df;
  color: var(--gold-600);
}

.invite-message {
  margin-top: 12rpx;
  color: var(--text-500);
  font-size: 22rpx;
  line-height: 1.55;
}

.invite-actions {
  display: grid;
  grid-template-columns: 0.78fr 1.22fr;
  gap: 12rpx;
  margin-top: 18rpx;
}

.invite-action {
  width: 100%;
}

.skill-count {
  background: #f1f4f8;
  color: #7b8799;
}

.skill-list {
  display: flex;
  flex-wrap: wrap;
}

.skill-empty {
  padding: 34rpx 10rpx 20rpx;
  color: var(--text-400);
  font-size: 22rpx;
  text-align: center;
}

@keyframes state-spin {
  to { transform: rotate(360deg); }
}
